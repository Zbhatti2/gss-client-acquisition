# Copy this file to .env and fill in the real value(s).
#
#     copy .env.example .env        (PowerShell / cmd, from App\)
#
# .env holds the real secrets and is git-ignored (see .gitignore). Never
# commit it. This file -- .env.example -- is committed, so keep
# placeholders only.
#
# app.py calls load_dotenv() on startup, so anything set here is available
# as a normal environment variable to the rest of the app. A real OS-level
# environment variable of the same name still wins over .env.

# Only needed for Data Exchange > Import Business Card (AI) -- the rest of
# GSS runs fine without it. Your Anthropic API key; get one at
# console.anthropic.com. (Zeb: this can be the same key already set up for
# the Book to Movie Studio app, rather than a new one.)
ANTHROPIC_API_KEY=sk-ant-api03-...
